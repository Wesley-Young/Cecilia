{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024"],
    // Main, preload and the account process are bundled by electron-vite, so bundler resolution matches how they run.
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "types": ["node", "electron-vite/node"],
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "strict": true,
    "skipLibCheck": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src/core", "src/main", "src/account", "src/preload", "electron.vite.config.ts"]
}
